<Window
    x:Class="InfiSteam.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentGrid.(Grid.ColumnDefinitions)[0].Width" Value="260"/>
                        <Setter Target="ContentGrid.(Grid.ColumnDefinitions)[1].Width" Value="*"/>
                        <Setter Target="SidePanel.(Grid.Column)" Value="0"/>
                        <Setter Target="SidePanel.Visibility" Value="Visible"/>
                        <Setter Target="MainPanel.(Grid.Column)" Value="1"/>
                        <Setter Target="MobilePanel.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentGrid.(Grid.ColumnDefinitions)[0].Width" Value="0"/>
                        <Setter Target="ContentGrid.(Grid.ColumnDefinitions)[1].Width" Value="*"/>
                        <Setter Target="SidePanel.(Grid.Column)" Value="0"/>
                        <Setter Target="SidePanel.Visibility" Value="Collapsed"/>
                        <Setter Target="MainPanel.(Grid.Column)" Value="1"/>
                        <Setter Target="MobilePanel.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- 云母背景效果 -->
        <Grid.Background>
            <SolidColorBrush Color="Transparent"/>
        </Grid.Background>

        <!-- 自定义标题栏区域 -->
        <Grid x:Name="TitleBarGrid" 
              Grid.Row="0" 
              Height="48"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 标题和图标 -->
            <StackPanel Grid.Column="0" 
                        Orientation="Horizontal" 
                        Spacing="10" 
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                <Image x:Name="_appIcon" 
                       Width="20" 
                       Height="20"
                       VerticalAlignment="Center"/>
                <TextBlock Text="InfiSteam" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <!-- 拖拽区域 -->
            <StackPanel Grid.Column="1" 
                        x:Name="DragArea"
                        Background="Transparent"/>

            <!-- 系统窗口按钮区域 -->
            <Grid Grid.Column="2" x:Name="SystemButtonArea" Width="160"/>
        </Grid>

        <!-- 主内容区 - 自适应布局 -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Padding="16">
            <StackPanel>
            
            <!-- 移动端操作栏 -->
            <Border x:Name="MobilePanel"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="BtnDetect_Click" Height="36" MinWidth="80">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE721;" FontSize="14"/>
                            <TextBlock Text="检测" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="_btnMobileUpdate" 
                            Click="BtnUpdate_Click"
                            IsEnabled="False"
                            Height="36" MinWidth="80"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                            <TextBlock Text="更新" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid x:Name="ContentGrid" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SideCol" Width="260"/>
                    <ColumnDefinition x:Name="MainCol" Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航/状态面板 -->
                <StackPanel x:Name="SidePanel" 
                            Grid.Column="0" 
                            Spacing="16"
                            Margin="0,0,16,0">
                    <!-- 系统状态卡片 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="系统状态" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" x:Name="_icoStatusSteam"
                                              Glyph="&#xE10C;" FontSize="16"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Steam 状态" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" x:Name="_icoStatusGame"
                                              Glyph="&#xE10C;" FontSize="16"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="游戏文件" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" x:Name="_icoStatusAcf"
                                              Glyph="&#xE10C;" FontSize="16"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="ACF 配置" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </StackPanel>
                            <ProgressBar x:Name="_progressBar" IsIndeterminate="True" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- 操作按钮区 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="12">
                        <StackPanel Spacing="6">
                            <Button x:Name="_btnDetect" Click="BtnDetect_Click"
                                    HorizontalAlignment="Stretch" Height="38">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="14"/>
                                    <TextBlock Text="检测 Steam" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="_btnSteamDB" Click="BtnSteamDB_Click"
                                    IsEnabled="False" HorizontalAlignment="Stretch" Height="38">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="14"/>
                                    <TextBlock Text="查询 SteamDB" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="_btnRetry" Click="BtnRetry_Click"
                                    IsEnabled="False" Visibility="Collapsed" HorizontalAlignment="Stretch" Height="38">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                    <TextBlock Text="重试" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="_btnUpdate" Click="BtnUpdate_Click"
                                    IsEnabled="False" HorizontalAlignment="Stretch" Height="38"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                    <TextBlock Text="更新 ACF" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="_btnVerify" Click="BtnVerify_Click"
                                    IsEnabled="False" HorizontalAlignment="Stretch" Height="38">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE73E;" FontSize="14"/>
                                    <TextBlock Text="验证" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="_btnCloseChrome" Click="BtnCloseChrome_Click"
                                    HorizontalAlignment="Stretch" Height="38">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE711;" FontSize="14"/>
                                    <TextBlock Text="关闭 Chrome" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 扩展功能按钮区 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="扩展功能" FontSize="12" FontWeight="SemiBold" Opacity="0.7"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="4,4,0,4"/>
                            <Button x:Name="_btnDisclaimer" Click="BtnDisclaimer_Click"
                                    HorizontalAlignment="Stretch" Height="34">
                                <TextBlock Text="© 声明" FontSize="12" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="_btnResidual" Click="BtnResidual_Click"
                                    HorizontalAlignment="Stretch" Height="34">
                                <TextBlock Text="🧹 残留检查" FontSize="12" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="_btnSkeletonize" Click="BtnSkeletonize_Click"
                                    HorizontalAlignment="Stretch" Height="34">
                                <TextBlock Text="💀 骨架化" FontSize="12" VerticalAlignment="Center"
                                           Foreground="#FF5252"/>
                            </Button>
                            <Button x:Name="_btnRestore" Click="BtnRestore_Click"
                                    HorizontalAlignment="Stretch" Height="34">
                                <TextBlock Text="📦 还原" FontSize="12" VerticalAlignment="Center"
                                           Foreground="#4CAF50"/>
                            </Button>
                            <Button x:Name="_btnNetDiag" Click="BtnNetDiag_Click"
                                    HorizontalAlignment="Stretch" Height="34">
                                <TextBlock Text="🌐 网络诊断" FontSize="12" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="_btnReport" Click="BtnReport_Click"
                                    HorizontalAlignment="Stretch" Height="34">
                                <TextBlock Text="📋 报告" FontSize="12" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 用户帮助区 -->
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <Button x:Name="_btnGuide" Click="BtnGuide_Click"
                                HorizontalAlignment="Stretch" Height="34"
                                Background="Transparent">
                            <TextBlock Text="❓ 快速上手指南" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource SystemAccentColorBrush}"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="InfiSteam v5.0 (WinUI 3)" FontSize="12" Opacity="0.5"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <HyperlinkButton x:Name="_btnAbout" Content="关于 InfiSteam" FontSize="12"
                                         HorizontalAlignment="Center" Click="BtnAbout_Click"/>
                        <TextBlock Text="©mocabolka with CodeBuddy" FontSize="11" Opacity="0.4"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧主面板 -->
                <StackPanel x:Name="MainPanel" Grid.Column="1" Spacing="16">
                    <InfoBar x:Name="_infoBarStatus" Title="就绪"
                             Message="点击「检测 Steam」开始检查"
                             Severity="Informational" IsOpen="True"/>

                    <!-- 路径信息 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="路径信息" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Steam 路径"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="_txtSteamPath"
                                         IsReadOnly="True" FontSize="13"
                                         Background="Transparent" BorderThickness="0,0,0,1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="游戏路径"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="_txtGamePath"
                                         IsReadOnly="True" FontSize="13"
                                         Background="Transparent" BorderThickness="0,0,0,1"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="ACF 路径"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="_txtAcfPath"
                                         IsReadOnly="True" FontSize="13"
                                         Background="Transparent" BorderThickness="0,0,0,1"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="版本类型"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="_txtVersionType"
                                         IsReadOnly="True" FontSize="13"
                                         Background="Transparent" BorderThickness="0,0,0,1"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 版本对比 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="版本对比" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                                        CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="本地版本" FontSize="13" Opacity="0.7"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Build ID" FontSize="11" Opacity="0.6"/>
                                            <TextBlock x:Name="_txtLocalBuildId" FontSize="22" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="-"/>
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Manifest GID" FontSize="11" Opacity="0.6"/>
                                            <TextBlock x:Name="_txtLocalManifest" FontSize="14" FontFamily="Consolas"
                                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="-"/>
                                        </StackPanel>
                                        <FontIcon x:Name="_icoBuild" Glyph="" FontSize="18" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                                        CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="SteamDB 最新" FontSize="13" Opacity="0.7"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Build ID" FontSize="11" Opacity="0.6"/>
                                            <TextBlock x:Name="_txtRemoteBuildId" FontSize="22" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="-"/>
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Manifest GID" FontSize="11" Opacity="0.6"/>
                                            <TextBlock x:Name="_txtRemoteManifest" FontSize="14" FontFamily="Consolas"
                                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="-"/>
                                        </StackPanel>
                                        <FontIcon x:Name="_icoManifest" Glyph="" FontSize="18" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ACF 配置 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="ACF 配置状态" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Grid.Column="0"
                                        Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="StateFlags" FontSize="11" Opacity="0.6"/>
                                        <TextBlock x:Name="_txtStateFlags" Text="-" FontSize="18" FontWeight="SemiBold"/>
                                        <FontIcon x:Name="_icoStateFlags" Glyph="" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1"
                                        Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="TargetBuildID" FontSize="11" Opacity="0.6"/>
                                        <TextBlock x:Name="_txtTargetBuildId" Text="-" FontSize="18" FontWeight="SemiBold"/>
                                        <FontIcon x:Name="_icoTargetBuildId" Glyph="" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2"
                                        Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="AutoUpdate" FontSize="11" Opacity="0.6"/>
                                        <TextBlock x:Name="_txtAutoUpdate" Text="-" FontSize="18" FontWeight="SemiBold"/>
                                        <FontIcon x:Name="_icoAutoUpdate" Glyph="" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0"
                                        Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="BytesToDownload" FontSize="11" Opacity="0.6"/>
                                        <TextBlock x:Name="_txtBytesToDownload" Text="-" FontSize="18" FontWeight="SemiBold"/>
                                        <FontIcon x:Name="_icoBytesToDownload" Glyph="" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1"
                                        Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="只读锁定" FontSize="11" Opacity="0.6"/>
                                        <TextBlock x:Name="_txtReadOnly" Text="-" FontSize="18" FontWeight="SemiBold"/>
                                        <FontIcon x:Name="_icoReadOnly" Glyph="" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 启动器警告 -->
                    <Border x:Name="_borderLauncher" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="20" Visibility="Collapsed">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;" FontSize="22"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                <TextBlock Text="检测到独立启动器" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                            </StackPanel>
                            <TextBlock Text="如果在 Steam 外使用了独立启动器安装游戏，为避免版本冲突，建议在 Steam 游戏属性 → 启动选项中填入以下命令："
                                       TextWrapping="Wrap" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="8" Padding="14">
                                <TextBlock x:Name="_txtLaunchOption" FontFamily="Consolas" FontSize="14"
                                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="_btnCopyLaunchOption" Content="复制到剪贴板"
                                        Click="BtnCopyLaunchOption_Click"
                                        Style="{StaticResource AccentButtonStyle}" Height="34"/>
                                <TextBlock x:Name="_txtCopyConfirm" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 日志 -->
                    <Border x:Name="_logCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="20">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8FD;" FontSize="18"
                                          Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                <TextBlock Text="执行日志" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="_logCount" Text="(0)" FontSize="12" VerticalAlignment="Center"
                                           Opacity="0.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ListView x:Name="_lvLog" Height="120"
                                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                                      BorderThickness="0" FontFamily="Consolas" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
        </ScrollViewer>

        <!-- ====== Toast 通知浮层（居中 + 动画） ====== -->
        <Border x:Name="_toastBorder"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#CC1A73E8"
                BorderThickness="0"
                CornerRadius="10"
                Padding="20,14"
                Margin="0,0,0,32"
                Visibility="Collapsed"
                MaxWidth="600"
                RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="_toastTransform" Y="50"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon x:Name="_toastIcon" Glyph="&#xE946;" FontSize="16" VerticalAlignment="Center" Foreground="White"/>
                <TextBlock x:Name="_toastText"
                           TextWrapping="Wrap"
                           FontSize="15"
                           FontFamily="Consolas"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
