<Window x:Class="InfiSteam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InfiSteam — 无限暖暖 Steam 壳管理工具"
        Icon="pack://application:,,,/ico.ico"
        Width="920" Height="720" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        FontSize="13"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,2"/>
        </Style>

        <Style TargetType="TextBox" x:Key="InfoBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="IconText">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== Top Toolbar ========== -->
        <Border Grid.Row="0" Background="#E8E8E8" Padding="8,6" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="InfiSteam" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>

                <!-- Row 1: Core buttons -->
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnDetect" Content="🔍 检测 Steam" Click="BtnDetect_Click" Style="{StaticResource ActionButton}"/>
                    <Button x:Name="btnSteamDB" Content="🌐 查询 SteamDB" Click="BtnSteamDB_Click" Style="{StaticResource ActionButton}" IsEnabled="False"/>
                    <Button x:Name="btnRetry" Content="🔄 重试" Click="BtnRetry_Click" Style="{StaticResource ActionButton}" IsEnabled="False" Visibility="Collapsed"/>
                    <Button x:Name="btnUpdate" Content="📝 更新 ACF" Click="BtnUpdate_Click" Style="{StaticResource ActionButton}" IsEnabled="False"/>
                    <Button x:Name="btnVerify" Content="✅ 验证" Click="BtnVerify_Click" Style="{StaticResource ActionButton}" IsEnabled="False"/>
                    <Button x:Name="btnCloseChrome" Content="✖ 关闭 Chrome" Click="BtnCloseChrome_Click" Style="{StaticResource ActionButton}"/>
                </StackPanel>

                <!-- Row 2: Extended buttons -->
                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnDisclaimer" Content="© 声明" Click="BtnDisclaimer_Click" Style="{StaticResource ActionButton}"/>
                    <Button x:Name="btnResidual" Content="🧹 残留检查" Click="BtnResidual_Click" Style="{StaticResource ActionButton}"/>
                    <Button x:Name="btnSkeletonize" Content="💀 骨架化" Click="BtnSkeletonize_Click" Style="{StaticResource ActionButton}" Foreground="#D13438"/>
                    <Button x:Name="btnRestore" Content="📦 还原" Click="BtnRestore_Click" Style="{StaticResource ActionButton}"/>
                    <Button x:Name="btnNetDiag" Content="🌐 网络诊断" Click="BtnNetDiag_Click" Style="{StaticResource ActionButton}"/>
                    <Button x:Name="btnReport" Content="📋 报告" Click="BtnReport_Click" Style="{StaticResource ActionButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== Main Content ========== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
            <StackPanel>

                <!-- Status -->
                <Border x:Name="borderStatus" Background="#E3F2FD" Padding="8,5" CornerRadius="3" Margin="0,0,0,10">
                    <TextBlock x:Name="txtStatus" Text="就绪，点击「检测 Steam」开始" FontSize="13"/>
                </Border>

                <!-- Progress -->
                <ProgressBar x:Name="progressBar" Height="6" IsIndeterminate="True"
                             Visibility="Collapsed" Margin="0,0,0,8"/>

                <!-- ====== Steam 信息 ====== -->
                <Border Background="#FAFAFA" Padding="10" CornerRadius="4" BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Steam 信息" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Steam 路径" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtSteamPath" Style="{StaticResource InfoBox}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="icoSteam" Style="{StaticResource IconText}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="游戏路径" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtGamePath" Style="{StaticResource InfoBox}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="icoGame" Style="{StaticResource IconText}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="ACF 路径" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtAcfPath" Style="{StaticResource InfoBox}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="icoAcf" Style="{StaticResource IconText}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="版本类型" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtVersionType" Style="{StaticResource InfoBox}"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="icoVersion" Style="{StaticResource IconText}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ====== 版本对比 ====== -->
                <Border Background="#FAFAFA" Padding="10" CornerRadius="4" BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="版本对比" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Build ID" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtLocalBuildId" Style="{StaticResource InfoBox}" Text=""/>
                            <TextBox Grid.Row="0" Grid.Column="2" x:Name="txtRemoteBuildId" Style="{StaticResource InfoBox}" Text=""/>
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="icoBuild" Style="{StaticResource IconText}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Manifest GID" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtLocalManifest" Style="{StaticResource InfoBox}" Text=""/>
                            <TextBox Grid.Row="1" Grid.Column="2" x:Name="txtRemoteManifest" Style="{StaticResource InfoBox}" Text=""/>
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="icoManifest" Style="{StaticResource IconText}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ====== ACF 配置状态 ====== -->
                <Border Background="#FAFAFA" Padding="10" CornerRadius="4" BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="ACF 配置状态" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="StateFlags (应为 4)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtStateFlags" Style="{StaticResource InfoBox}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="icoStateFlags" Style="{StaticResource IconText}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="TargetBuildID (应为 0)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtTargetBuildId" Style="{StaticResource InfoBox}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="icoTargetBuildId" Style="{StaticResource IconText}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="AutoUpdateBehavior (应为 1)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtAutoUpdate" Style="{StaticResource InfoBox}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="icoAutoUpdate" Style="{StaticResource IconText}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="BytesToDownload (应为 0)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtBytesToDownload" Style="{StaticResource InfoBox}"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="icoBytesToDownload" Style="{StaticResource IconText}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="ACF 只读锁定" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtReadOnly" Style="{StaticResource InfoBox}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="icoReadOnly" Style="{StaticResource IconText}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ====== 独立启动器 ====== -->
                <Border x:Name="borderLauncher" Background="#FFF8E1" Padding="10" CornerRadius="4"
                        BorderBrush="#FFE082" BorderThickness="1" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="⚠ 检测到独立启动器" FontSize="14" FontWeight="SemiBold" Foreground="#E65100" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12">
                            如果在 Steam 外使用了独立启动器安装游戏，为避免版本冲突，建议在
                            <Bold>Steam 游戏属性 → 启动选项</Bold>中填入以下命令：
                        </TextBlock>
                        <Border Background="#F5F5F5" Padding="8,6" CornerRadius="2" BorderBrush="#CCC" BorderThickness="1" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="启动选项命令" FontSize="11" FontWeight="SemiBold" Foreground="#888" Margin="0,0,0,2"/>
                                <TextBlock x:Name="txtLaunchOption" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Button Content="📋 复制到剪贴板" Click="BtnCopyLaunchOption_Click" Width="140" Height="26" FontSize="11"/>
                        <TextBlock x:Name="txtCopyConfirm" Text="" FontSize="11" Foreground="Green" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ====== 执行日志 ====== -->
                <Border Background="#FAFAFA" Padding="10" CornerRadius="4" BorderBrush="#DDDDDD" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="执行日志" Style="{StaticResource SectionTitle}"/>
                        <ListView x:Name="lvLog" Height="200" BorderThickness="1" BorderBrush="#E0E0E0"
                                  FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ========== Bottom Bar ========== -->
        <Border Grid.Row="2" Background="#E8E8E8" Padding="8,4" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="txtBottomStatus" Text="就绪" VerticalAlignment="Center" FontSize="11" Foreground="#666666"/>
                <TextBlock Grid.Column="1" Text="InfiSteam v5.0 (WPF)" VerticalAlignment="Center" FontSize="11" Foreground="#999999"/>
            </Grid>
        </Border>

    </Grid>
</Window>
